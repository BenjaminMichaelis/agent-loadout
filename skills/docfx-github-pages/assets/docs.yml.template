name: Documentation

on:
  pull_request:
    paths:
      - "docs/**"
      - "README.md"
      - "docfx.json"
      - "__TOOL_MANIFEST__"
      - "toc.yml"
      - "scripts/check_docs.py"
      - ".github/workflows/docs.yml"
  push:
    branches: ["__DEFAULT_BRANCH__"]
    paths:
      - "docs/**"
      - "README.md"
      - "docfx.json"
      - "__TOOL_MANIFEST__"
      - "toc.yml"
      - "scripts/check_docs.py"
      - ".github/workflows/docs.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: docs-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  build:
    name: Build documentation
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Set up .NET
        uses: actions/setup-dotnet@0f4a354dd5547a28c70b7853dbd95d5b67886e73 # v6.1.0
        with:
          dotnet-version: "__DOCS_SDK__"
      - name: Restore DocFX
        run: dotnet tool restore
      - name: Build site
        run: dotnet docfx build docfx.json --warningsAsErrors
      - name: Check generated links
        run: python3 scripts/check_docs.py _site --base-url "__PAGES_URL__"
      - name: Upload Pages artifact
        if: github.ref == 'refs/heads/__DEFAULT_BRANCH__' && github.event_name != 'pull_request'
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: _site

  deploy:
    name: Deploy to GitHub Pages
    if: github.ref == 'refs/heads/__DEFAULT_BRANCH__' && github.event_name != 'pull_request'
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Configure Pages
        uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6.0.0
      - name: Deploy site
        id: deployment
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
