{
  "build": {
    "content": [
      {
        "files": ["index.md"],
        "src": "docs"
      },
      {
        "files": ["README.md", "toc.yml", "docs/**/*.md", "docs/**/toc.yml"],
        "exclude": ["docs/index.md", "docs/template/**"]
      }
    ],
    "resource": [
      {
        "files": ["docs/assets/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern", "docs/template"],
    "postProcessors": ["ExtractSearchIndex"],
    "globalMetadata": {
      "_appName": "__PROJECT_NAME__",
      "_appTitle": "__PROJECT_NAME__",
      "_appLogoPath": "docs/assets/logo.svg",
      "_appFaviconPath": "docs/assets/logo.svg",
      "_enableSearch": true,
      "_disableNewTab": true,
      "_lang": "en",
      "_gitContribute": {
        "repo": "__REPO_URL__",
        "branch": "__DEFAULT_BRANCH__"
      }
    },
    "fileMetadata": {
      "_layout": {
        "README.md": "landing"
      }
    },
    "sitemap": {
      "baseUrl": "__PAGES_URL__"
    }
  }
}
